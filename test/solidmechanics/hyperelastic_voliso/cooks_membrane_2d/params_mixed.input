[Grid]
File = ../../cooksmembrane.msh
Refinement = 1

[Problem]
Name = test_hyperelastic_cooks_membrane
EnableGravity = false
ShearTraction = 20.0

[SpatialParams]
# shear modulus and Lamé's first parameter in MPa (Schröder et al. 2021), Poisson's ratio 0.35 to 0.4999
Mu = 185.185
Lambda = 432.099
LambdaValues = 432.099 750 9260 92600 926000

[Component]
SolidDensity = 1.0

[Vtk]
Precision = Float64
CoordPrecision = Float64
AddProcessRank = false

[Newton]
EnableDynamicOutput = false
MaxRelativeShift = 1e-6
MaxSteps = 25
UseLineSearch = true
