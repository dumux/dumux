[Grid]
File = square.msh

[Problem]
Name = test_kirchhoff_love_free_corner
E = 1e6
Thickness = 0.05
PoissonRatio = 0.3
Force = 1.0
Length = 1.0
# corner points to probe, as x y pairs
Corners = 1 1  1 0  0 1

[Vtk]
Precision = Float64
CoordPrecision = Float64

[Newton]
EnableDynamicOutput = false
MaxRelativeShift = 1e-8

[Assembly.NumericDifference]
BaseEpsilon = 1e-5
