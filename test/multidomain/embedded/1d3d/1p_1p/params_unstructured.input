[MixedDimension]
NumCircleSegments = 256
IntegrationOrder = 2
KernelWidthFactor = 1.0
WriteIntegrationPointsToFile = false
KernelIntegrationCRL = 0.01

[Vessel.Grid]
LowerLeft = 0 0 0
UpperRight = 0 0 1
Cells = 20

[Tissue.Grid]
# generated from box.geo at build time, box_<characteristic length>.msh
File = box_0.30.msh

[Vessel.Problem]
Name = 1d

[Tissue.Problem]
Name = 3d

[Problem]
Name = test_md_embedded_1d3d_1p1p_unstructured
EnableGravity = false

[L2Error]
IntegrationOrder = 1

[Vtk]
OutputName = test_md_embedded_1d3d_1p1p_boxtpfa_kernel_unstructured

[Component]
LiquidKinematicViscosity = 1 # [m^2/s]
LiquidDensity = 1 # [kg/m^3]

[SpatialParams]
PermeabilityTissue = 1 # [m^2]
Radius = 0.3 # [m]

[BoundaryConditions1D]
PressureInput = 2.0
DeltaPressure = 1.0

[LinearSolver]
ResidualReduction = 1e-25

[Assembly.NumericDifference]
PriVarMagnitude = 1e5
BaseEpsilon = 1e5
