[TimeLoop]
DtInitial = 7200      # [s] = 2 hours
EpisodeLength = 7200  # [s] = 2 hours
TEnd = 432000         # [s] = 5 days

[Voids.Grid]
File = ./grids/pipe.dgf
Refinement = 2 # set to 2 to reproduce the resuts of the plot

[Soil.Grid]
Positions0 = -5 0 5
Positions1 = -5 0 5
Positions2 = -30 0
Cells0 = 10 10
Cells1 = 10 10
Cells2 = 10
Grading0 = -1.3 1.3
Grading1 = -1.3 1.3
Refinement = 2 # set to 2 to reproduce the resuts of the plot

[Voids.Problem]
Name = 1d
InjectionRate = 0.0002 # [m³/s]
InjectionTemperature = 293.15 # [K] = 20° C

[Soil.Problem]
Name = 3d

[Problem]
EnableGravity = false

[SpatialParams]
Permeability = 1e-20

[Vtk]
OutputName = test_wellbore_heat_transport
AddVelocity = true
AddProcessRank = false

[MixedDimension]
NumCircleSegments = 200
PipeWallThermalConductivity = 0.962 # [W/(m·K)], combined conductivity of pipe wall and grout

[Component]
SolidDensity = 1800
SolidThermalConductivity = 2.78018
SolidHeatCapacity = 1778

[PointSource]
EnableBoxLumping = false

[Flux]
UpwindWeight = 0.5
