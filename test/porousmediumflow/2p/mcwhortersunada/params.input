[TimeLoop]
DtInitial = 1e3 # [s]
TEnd = 3e6 # [s], keeps the plume inside the domain on coarse grids
MaxTimeStepSize = 5e4 # [s]

[Grid]
LowerLeft = 0 0
UpperRight = 2 1 # [m]
Cells = 400 1

[Problem]
Name = test_2p_mcwhortersunada_tpfa
EnableGravity = false
ReferencePressure = 1e5 # [Pa]
InjectionPressure = 1e5 # [Pa]

MaxRelError = 0.04 # relative imbibed-mass, center-of-mass and saturation L1 errors

[Reference]
NumIntervals = 4000 # saturation intervals, independent of the spatial grid
Tolerance = 1e-10 # relative change of the Fucik integrand
MaxIterations = 10000

[SpatialParams]
Permeability = 1e-13 # [m^2]
Porosity = 0.2 # [-]
BrooksCoreyLambda = 3.0 # [-]
BrooksCoreyPcEntry = 8000 # [Pa]
Swr = 0.2 # [-]
Snr = 0.2 # [-]
Temperature = 283.15 # [K]

[2.Component]
Name = nonwetting
MolarMass = 0.018 # [kg/mol]
LiquidDensity = 1000 # [kg/m^3]
LiquidDynamicViscosity = 1e-3 # [Pa*s]
