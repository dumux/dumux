[TimeLoop]
DimensionlessTimeStepSize = 1e-3
NumTimeSteps = 20

[Grid]
LowerLeft = 0 0
UpperRight = 1 1
Cells = 32 32

[Problem]
Name = hortonrogerslapwood
EnableGravity = true
DensityDifference = 500 # [kg/m^3]
Amplitude = 1e-3

[SpatialParams]
Permeability = 6.4388856439318965e-15 # [m^2], Ra = 8 pi^2
Porosity = 0.4
Tortuosity = 1.0
Temperature = 293.15 # [K]

[1.Component]
Name = Solvent
MolarMass = 18e-3 # [kg/mol]
LiquidDensity = 1000 # [kg/m^3]
LiquidDynamicViscosity = 1e-3 # [Pa s]

[2.Component]
Name = Solute
MolarMass = 18e-3 # [kg/mol]
LiquidDiffusionCoefficient = 1e-9 # [m^2/s]

[Newton]
MaxRelativeShift = 1e-12

[Vtk]
AddVelocity = true
