[TimeLoop]
DtInitial = 1 # [s]
TEnd = 2.2e12 # [s]
EpisodeLength = 1.e10

[Grid]
File = ./grids/heatpipe.dgf

[Assembly]
NumericDifferenceMethod = 0

[Problem]
Permeability = 1.e-12   # m^2
HeatFlux = -100.0       # W/m^2
LeftTemperature = 341.7588 # K, in equilibrium with x_g^a = 0.7 (Huang et al. 2015, eq. 11)
Name = heatpipe
EnableGravity = false
ReferenceDryOutPosition = 1.8691 # m, semi-analytical solution (test_heatpipe_odesolver)
MaxDryOutDeviation = 0.12 # m, allowed downstream deviation of the simulated dry-out front

[Component]
SolidHeatCapacity = 700
SolidDensity = 2600
SolidThermalConductivity = 2.8 # unused, see thermalconductivity.hh

[Newton]
MaxRelativeShift = 1e-6
